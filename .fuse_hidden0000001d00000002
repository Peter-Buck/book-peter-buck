  document.querySelectorAll('.checklist-box').forEach((box, i) => {
    const key = 'check_' + i;
    if (sessionStorage.getItem(key) === '1') box.classList.add('checked');
    box.addEventListener('click', () => {
      sessionStorage.setItem(key, box.classList.contains('checked') ? '1' : '');
    });
  });
</script>

</body>
</html>
